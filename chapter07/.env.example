# ============================================================
# New in v0.7: SSE streaming
# ============================================================

# SSE heartbeat interval (ms). Intermediate hops (Nginx default proxy_read_timeout
# 60s) will not cut a connection that still has traffic; we write a
# ': keepalive\n\n' line every 15s to prevent idle timeouts.
SSE_HEARTBEAT_MS=15000

# Mock upstream URL (after `npm run mock`). Main router has a route rule with prefix='mock-'.
MOCK_BASE_URL=http://localhost:4010
MOCK_PORT=4010
MOCK_CHUNK_INTERVAL_MS=250

# ============================================================
# From v0.6: rate limits + monthly quota
# ============================================================

GLOBAL_QPS_LIMIT=0
GLOBAL_TPM_LIMIT=0
PER_MODEL_QPS_LIMIT=0
PER_MODEL_TPM_LIMIT=0

# ============================================================
# From v0.5: billing pipeline
# ============================================================

INITIAL_BALANCE_CNY=100
DEFAULT_MAX_TOKENS=4096

# ============================================================
# From v0.4: persistence + internal Key system
# ============================================================

DATABASE_URL=./data/gateway.db
ADMIN_TOKEN=admin-change-me

# ============================================================
# Upstream keys
# ============================================================

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-replace-me

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VERSION=2023-06-01

PORT=3000

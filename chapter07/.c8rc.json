{
  "include": [
    "src/adaptors/**/*.ts",
    "src/streaming/anthropic-events.ts",
    "src/db/client.ts",
    "src/db/migrate.ts"
  ],
  "exclude": [
    "src/adaptors/__tests__/**",
    "src/adaptors/base.ts",
    "src/db/__tests__/**",
    "**/*.test.ts",
    "**/node_modules/**"
  ],
  "reporter": ["text", "lcov", "json-summary", "html"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 70,
  "statements": 70,
  "functions": 70,
  "branches": 50,
  "all": true,
  "temp-directory": "./coverage/tmp"
}

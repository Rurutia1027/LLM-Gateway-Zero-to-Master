# ============================================================
# New in v0.6: rate limits + monthly quota
# (hand-type values / wire-up in limit/ + billing/quota.ts)
# ============================================================

# Global QPS cap (process-wide across all clients). 0 = unlimited.
GLOBAL_QPS_LIMIT=

# Global TPM cap (process-wide tokens per minute). 0 = unlimited.
GLOBAL_TPM_LIMIT=

# Per-model QPS / TPM caps (apply to every model). 0 = unlimited.
PER_MODEL_QPS_LIMIT=
PER_MODEL_TPM_LIMIT=

# ============================================================
# From v0.5: billing pipeline
# ============================================================

# Default initial balance (CNY) when creating a user without an explicit balance.
# Same currency convention as the price table (CNY in this chapter).
INITIAL_BALANCE_CNY=100

# When the client omits max_tokens, preConsume uses this as the estimated output cap.
# Larger value = larger reservation, but also catches runaway calls earlier.
DEFAULT_MAX_TOKENS=4096

# ============================================================
# From v0.4: persistence + internal Key system
# ============================================================

# Local SQLite database path (relative to example root)
DATABASE_URL=./data/gateway.db

# Admin API master token. Required to create users / issue keys / revoke keys.
# Replace with a strong random string in production.
ADMIN_TOKEN=admin-change-me

# ============================================================
# Upstream keys (same as v0.3/v0.4; separate from internal gateway keys)
# ============================================================

# OpenAI upstream
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-replace-me

# DeepSeek upstream (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me

# Anthropic upstream
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VERSION=2023-06-01

# Server listen port
PORT=3000

# ============================================================
# New in v0.4: persistence + internal Key system
# ============================================================

# Local SQLite database file path (relative to the example root)
DATABASE_URL=./data/gateway.db

# Master token for the admin API. Required to create users / issue keys / revoke keys.
# In production, replace this with a strong random string, or anyone can issue new keys.
ADMIN_TOKEN=admin-change-me

# ============================================================
# Upstream keys (same as v0.3; separate from the new internal gateway keys)
# ============================================================

# OpenAI upstream
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-replace-me

# DeepSeek upstream (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me

# Anthropic upstream (largest protocol differences)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VERSION=2023-06-01

# Server listen port
PORT=3000
